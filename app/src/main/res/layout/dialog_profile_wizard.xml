<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    android:backgroundTint="@color/chip_background_selector"
    app:strokeColor="#EAEAEA">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"

            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="8dp"

            android:src="@drawable/ic_close"

            android:contentDescription="Close"
            app:tint="#757575" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- TOP ICON -->



        <!-- TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Complete your profile"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="18dp"
            android:layout_gravity="center"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This takes less than a minute"
            android:textSize="14sp"
            android:textColor="#7B7B7B"
            android:layout_marginTop="6dp"
            android:layout_gravity="center"/>

        <!-- STEP INDICATOR -->

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/profileProgress"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="28dp"
            android:max="100"
            android:progress="50"/>

        <ViewFlipper
            android:id="@+id/wizardFlipper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp">

            <!-- EMAIL -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/emailLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Email"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusBottomEnd="18dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"/>

                </com.google.android.material.textfield.TextInputLayout>
                <TextView
                    android:id="@+id/tvEmailNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="A verification link will be sent to your email. Only verified email addresses will receive email notifications."
                    android:textSize="12sp"
                    android:textColor="#7B7B7B"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="26dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Continue"
                        android:backgroundTint="@color/sagar_button"
                        app:cornerRadius="18dp"/>

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressEmail"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:visibility="gone"/>

                </FrameLayout>
            </LinearLayout>

            <!-- DOB -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/dobLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Date of Birth"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDob"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:focusable="false"/>

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvDobNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Your date of birth helps us personalize your experience and provide relevant updates."
                    android:textSize="12sp"
                    android:textColor="#7B7B7B"/>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="26dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFinish"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Continue"
                        android:backgroundTint="@color/sagar_button"
                        app:cornerRadius="18dp"/>

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/progressFinish"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:visibility="gone"/>

                </FrameLayout>

            </LinearLayout>

        </ViewFlipper>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>