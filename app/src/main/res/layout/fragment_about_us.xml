<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AboutUsFragment">
    <!-- SHIMMER -->
    <include
        android:id="@+id/shimmerLayout"
        layout="@layout/shimmer_about_us"/>

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:id="@+id/main"
        android:visibility="gone"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ABOUT US -->
            <TextView
                android:id="@+id/aboutUsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About Us"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:paddingBottom="8dp"/>

            <TextView
                android:id="@+id/about_us_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="We are committed to delivering the best quality products with love, trust, and customer satisfaction. Our journey started with a passion for excellence."
                android:textSize="14sp"
                android:textColor="#666666"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="20dp"/>

            <!-- PRESENTS -->
            <TextView
                android:id="@+id/present_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Presents"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:paddingBottom="8dp"/>

            <TextView
                android:id="@+id/presentDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="A wide range of sweets, snacks, and delights crafted with traditional recipes and modern quality standards."
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="20dp"/>

            <!-- TESTIMONIALS -->
            <TextView
                android:id="@+id/testimonialTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Testimonials"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:paddingBottom="12dp"/>

            <!-- Testimonial Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/testimonialDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="“Amazing quality and taste! Highly recommended.”"
                    android:textSize="14sp"
                    android:textColor="#444444"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="- Someone Says"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>
            </LinearLayout>

            <!-- MEET OUR TEAM -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meet Our Team"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:paddingBottom="12dp"/>

            <!-- Team Member -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTeam"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

        </LinearLayout>
    </ScrollView>


</FrameLayout>