<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shimmerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:shimmer_auto_start="true"
    app:shimmer_duration="1200"
    app:shimmer_base_alpha="0.7"
    app:shimmer_highlight_alpha="1.0">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#F5F5F5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Profile Image -->
            <View
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_circle_gray" />

            <!-- Name -->
            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_shimmer_rect" />

            <!-- DOB -->
            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_shimmer_rect" />

            <!-- Age -->
            <View
                android:layout_width="80dp"
                android:layout_height="18dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_shimmer_rect_small" />

            <!-- Email -->
            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_shimmer_rect" />

            <!-- Phone -->
            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_shimmer_rect" />

            <!-- Security Title -->
            <View
                android:layout_width="120dp"
                android:layout_height="22dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_shimmer_rect_small" />

            <!-- Password Fields -->
            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_shimmer_rect" />

            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_shimmer_rect" />

            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_shimmer_rect" />

            <!-- Saved Address Title -->
            <View
                android:layout_width="180dp"
                android:layout_height="24dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_shimmer_rect_small" />

            <!-- Address Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Home Row -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@drawable/bg_shimmer_circle" />

                        <View
                            android:layout_width="80dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_shimmer_rect_small" />

                    </LinearLayout>

                    <!-- Address Lines -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="14dp"
                        android:layout_marginTop="14dp"
                        android:background="@drawable/bg_shimmer_rect_small" />

                    <View
                        android:layout_width="150dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_shimmer_rect_small" />

                    <!-- Phone -->
                    <View
                        android:layout_width="120dp"
                        android:layout_height="14dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_shimmer_rect_small" />

                    <!-- Button -->
                    <View
                        android:layout_width="140dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_shimmer_button" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Add Address Button -->
            <View
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_shimmer_button" />

            <!-- Switch -->
            <View
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_shimmer_rect" />

            <!-- Save Button -->
            <View
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_shimmer_button" />

            <!-- Logout Button -->
            <View
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_shimmer_button" />

        </LinearLayout>

    </ScrollView>

</com.facebook.shimmer.ShimmerFrameLayout>