<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="16dp"
    android:elevation="2dp"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="12dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvOrderStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Order Cancelled"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#D32F2F" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="#666" />
    </RelativeLayout>

    <!-- Server Message -->
    <TextView
        android:id="@+id/tvMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Order is already cancelled or delivered. Please track your order details."
        android:textSize="14sp"
        android:textColor="#666"/>

    <!-- Reason -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reason"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginTop="18dp"/>

    <TextView
        android:id="@+id/tvReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="System error"
        android:textSize="15sp"
        android:paddingTop="8dp"/>
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="System error"
        android:textSize="10sp"
        android:paddingTop="8dp"/>

    <!-- Details -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F6F6F6"
        android:padding="12dp"
        android:layout_marginTop="16dp">

        <TextView
            android:id="@+id/tvReturnDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Return Date : 12 Jun 2026, 17:35"/>

        <TextView
            android:id="@+id/tvCancelledBy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cancelled By : Admin"/>

        <TextView
            android:id="@+id/tvApproved"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cancellation approved or not"/>
        <TextView
            android:id="@+id/tvApprovedDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Approved At : 58:55:2025"/>
    </LinearLayout>

    <!-- Refund -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#FFF3E0"
        android:padding="12dp"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Refund Amount : "
            android:textStyle="bold"
            android:textColor="#E65100"/>

        <TextView
            android:id="@+id/tvRefundAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹1580"
            android:textStyle="bold"
            android:textColor="#E65100"/>
    </LinearLayout>

    <!-- Admin Note -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#4CAF50"
        android:padding="12dp"
        android:layout_marginTop="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="17dp"
            android:text="Note : "
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Refund approved successfully"
            android:textColor="@android:color/white"/>
    </LinearLayout>

    <!-- Bottom Button -->
    <Button
        android:id="@+id/btnDismiss"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:text="Close"
        android:backgroundTint="@color/sagar_button"/>

</LinearLayout>