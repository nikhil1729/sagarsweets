<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="@color/white">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verify OTP"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter the OTP sent to your registered mobile"
        android:textSize="14sp"
        android:textColor="@color/slot_closed_green"
        android:layout_marginBottom="30dp"/>
    <TextView
        android:id="@+id/tvError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="10dp"
        android:text="Invalid mobile number or password"
        android:textSize="14sp"
        android:textColor="#D32F2F"
        android:background="@drawable/bg_error"
        android:visibility="gone"
        android:drawableStart="@drawable/ic_error"
        android:drawablePadding="8dp"
        android:fontFamily="sans-serif-medium"/>

    <!-- OTP Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <EditText
            android:id="@+id/otp1"
            android:layout_width="40dp"
            android:layout_height="55dp"
            android:gravity="center"
            android:textSize="20sp"
            android:inputType="number"
            android:maxLength="1"
            android:background="@drawable/bg_otp_box"
            android:layout_margin="6dp"/>

        <EditText
            android:id="@+id/otp2"
            android:layout_width="40dp"
            android:layout_height="55dp"
            android:gravity="center"
            android:textSize="20sp"
            android:inputType="number"
            android:maxLength="1"
            android:background="@drawable/bg_otp_box"
            android:layout_margin="6dp"/>

        <EditText
            android:id="@+id/otp3"
            android:layout_width="40dp"
            android:layout_height="55dp"
            android:gravity="center"
            android:textSize="20sp"
            android:inputType="number"
            android:maxLength="1"
            android:background="@drawable/bg_otp_box"
            android:layout_margin="6dp"/>

        <EditText
            android:id="@+id/otp4"
            android:layout_width="40dp"
            android:layout_height="55dp"
            android:gravity="center"
            android:textSize="20sp"
            android:inputType="number"
            android:maxLength="1"
            android:background="@drawable/bg_otp_box"
            android:layout_margin="6dp"/>

        <EditText
            android:id="@+id/otp5"
            android:layout_width="40dp"
            android:layout_height="55dp"
            android:gravity="center"
            android:textSize="20sp"
            android:inputType="number"
            android:maxLength="1"
            android:background="@drawable/bg_otp_box"
            android:layout_margin="6dp"/>

        <EditText
            android:id="@+id/otp6"
            android:layout_width="40dp"
            android:layout_height="55dp"
            android:gravity="center"
            android:textSize="20sp"
            android:inputType="number"
            android:maxLength="1"
            android:background="@drawable/bg_otp_box"
            android:layout_margin="6dp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/txtTimer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resend OTP in 60s"
        android:textSize="13sp"
        android:textColor="@color/slot_closed_green"
        android:layout_marginTop="15dp"/>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/txtResendOtp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resend OTP"
            android:textColor="@color/md_theme_primary"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginTop="5dp"/>

        <ProgressBar
            android:id="@+id/progressResendOtp"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:visibility="gone"/>

    </FrameLayout>


    <!-- Verify OTP Button -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnVerifyOtp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Verify OTP"
            android:textAllCaps="false"
            android:layout_marginTop="30dp"
            android:backgroundTint="@color/sagar_button"
            android:textColor="@color/white"/>

        <ProgressBar
            android:id="@+id/progressVerifyOtp"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:visibility="gone"/>

    </FrameLayout>


</LinearLayout>