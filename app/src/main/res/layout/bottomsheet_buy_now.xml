<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- ORIGINAL CONTENT -->
    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- KEEP YOUR CURRENT FULL XML HERE -->

        <com.google.android.material.card.MaterialCardView

            xmlns:android="http://schemas.android.com/apk/res/android"

            xmlns:app="http://schemas.android.com/apk/res-auto"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            app:cardCornerRadius="18dp"

            app:cardElevation="4dp"

            app:cardBackgroundColor="@android:color/white">



            <LinearLayout

                android:layout_width="match_parent"

                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="12dp"

                android:background="@android:color/white">



                <!-- Header -->

                <RelativeLayout

                    android:layout_width="match_parent"

                    android:layout_height="28dp">



                    <!-- Handle -->

                    <View

                        android:layout_width="40dp"

                        android:layout_height="4dp"

                        android:layout_centerHorizontal="true"

                        android:layout_centerVertical="true"

                        android:background="#D9D9D9"/>



                    <!-- Close -->

                    <ImageView

                        android:id="@+id/btnClose"

                        android:layout_width="32dp"

                        android:layout_height="32dp"

                        android:layout_alignParentEnd="true"

                        android:padding="7dp"

                        android:background="@drawable/bg_close_circle"

                        android:src="@drawable/ic_close"

                        app:tint="#616161" />



                </RelativeLayout>



                <!-- Product -->

                <LinearLayout

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="20dp"

                    android:orientation="horizontal">



                    <ImageView

                        android:id="@+id/imgProduct"

                        android:layout_width="72dp"

                        android:layout_height="72dp"

                        android:scaleType="centerCrop"

                        android:src="@drawable/ic_launcher_background"/>



                    <LinearLayout

                        android:layout_width="0dp"

                        android:layout_height="wrap_content"

                        android:layout_weight="1"

                        android:layout_marginStart="14dp"

                        android:orientation="vertical">



                        <TextView

                            android:id="@+id/tvProductName"

                            android:layout_width="wrap_content"

                            android:layout_height="wrap_content"

                            android:text="Veg Korma"

                            android:textSize="16sp"

                            android:textStyle="bold"/>



                        <TextView

                            android:id="@+id/tvSelectedSize"

                            android:layout_width="wrap_content"

                            android:layout_height="wrap_content"

                            android:layout_marginTop="6dp"

                            android:textSize="12sp"

                            android:text="Selected Size : 500 g"

                            android:textColor="#777"/>



                        <TextView

                            android:id="@+id/tvPrice"

                            android:layout_width="wrap_content"

                            android:layout_height="wrap_content"

                            android:layout_marginTop="10dp"

                            android:text="₹220"

                            android:textStyle="bold"

                            android:textSize="18sp"/>



                    </LinearLayout>



                </LinearLayout>



                <!-- Quantity Section -->

                <LinearLayout

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="12dp"

                    android:gravity="center_vertical"

                    android:orientation="horizontal">



                    <TextView

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:text="Quantity"

                        android:textStyle="bold"

                        android:textSize="15sp"/>



                    <LinearLayout

                        android:id="@+id/layoutCartControl"

                        android:layout_width="wrap_content"

                        android:layout_marginStart="16dp"

                        android:orientation="horizontal"

                        android:gravity="center"

                        android:layout_height="28dp"

                        android:paddingHorizontal="4dp"

                        android:background="@drawable/bg_spinner"

                        >



                        <ImageView

                            android:id="@+id/btnMinus"

                            android:layout_width="18dp"

                            android:layout_height="18dp"

                            android:padding="2dp"

                            android:src="@drawable/ic_minus" />



                        <TextView

                            android:id="@+id/tvQuantity"

                            android:layout_height="wrap_content"

                            android:gravity="center"

                            android:text="1"

                            android:layout_width="28dp"

                            android:textSize="13sp"

                            android:textStyle="bold"

                            />



                        <ImageView

                            android:id="@+id/btnPlus"

                            android:layout_width="18dp"

                            android:layout_height="18dp"

                            android:padding="2dp"

                            android:src="@drawable/ic_plus" />



                    </LinearLayout>



                </LinearLayout>



                <!-- Delivery Details -->

                <LinearLayout

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:orientation="vertical"

                    android:layout_marginTop="14dp"

                    android:padding="10dp"

                    android:background="@drawable/bg_delivery_box">



                    <TextView

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:text="Delivery Details"

                        android:textStyle="bold"

                        android:textSize="15sp"/>

                    <!-- Delivery Address -->

                    <LinearLayout

                        android:id="@+id/layoutAddress"

                        android:layout_width="match_parent"

                        android:layout_height="wrap_content"

                        android:layout_marginTop="14dp"

                        android:background="@drawable/bg_spinner"

                        android:gravity="center_vertical"

                        android:orientation="horizontal"

                        android:minHeight="48dp"

                        android:padding="10dp">



                        <ImageView

                            android:layout_width="16dp"

                            android:layout_height="16dp"

                            android:src="@drawable/ic_location"/>



                        <LinearLayout

                            android:layout_width="0dp"

                            android:layout_height="wrap_content"

                            android:layout_weight="1"

                            android:layout_marginStart="12dp"

                            android:orientation="vertical">



                            <TextView

                                android:layout_width="wrap_content"

                                android:layout_height="wrap_content"

                                android:textSize="13sp"

                                android:text="Delivery Address"

                                android:textStyle="bold"/>



                            <TextView

                                android:id="@+id/tvSelectedAddress"

                                android:layout_width="match_parent"

                                android:layout_height="wrap_content"

                                android:layout_marginTop="2dp"

                                android:textSize="12sp"

                                android:text="Select delivery address"

                                android:textColor="#777"

                                android:maxLines="2"/>



                        </LinearLayout>



                        <ImageView
                            android:visibility="gone"
                            android:id="@+id/imgAddressArrow"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_arrow_right"/>
                    </LinearLayout>



                    <com.google.android.material.chip.ChipGroup

                        android:id="@+id/chipGroupTimeSlot"

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:layout_marginTop="12dp"

                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip

                            android:id="@+id/chipTimeSlot"

                            android:layout_width="wrap_content"

                            android:layout_height="wrap_content"

                            android:textSize="12sp"

                            app:chipMinHeight="34dp"

                            app:chipCornerRadius="14dp"

                            android:text="Now within 30 minutes"

                            android:textColor="@android:color/white"



                            app:chipBackgroundColor="@color/sagar_button"



                            app:chipIcon="@drawable/ic_clock"

                            app:chipIconVisible="true"

                            app:chipIconTint="@android:color/white"



                            app:chipStrokeWidth="0dp"/>



                    </com.google.android.material.chip.ChipGroup>

                    <TextView

                        android:id="@+id/tvEta"

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:layout_marginTop="8dp"

                        android:text="Estimated delivery • 25–30 min"

                        android:textColor="#2E7D32"

                        android:textSize="12sp"

                        android:textStyle="bold"/>



                    <com.google.android.material.chip.ChipGroup

                        android:id="@+id/chipGroupPayment"

                        android:layout_width="wrap_content"

                        android:layout_height="wrap_content"

                        android:layout_marginTop="12dp"

                        app:singleSelection="true"

                        app:selectionRequired="true">



                        <com.google.android.material.chip.Chip

                            android:id="@+id/chipPOD"

                            android:layout_width="wrap_content"

                            android:layout_height="wrap_content"

                            android:visibility="gone"

                            android:text="Pay on Delivery"

                            android:checkable="true"



                            android:textColor="@color/chip_text_selector"



                            app:chipBackgroundColor="@color/chip_payment_selector"

                            app:chipIconTint="@color/chip_text_selector"



                            app:chipIcon="@drawable/ic_cash"

                            app:chipIconVisible="true"



                            app:chipCornerRadius="14dp"

                            app:chipStrokeColor="#D6DCE5"

                            app:chipStrokeWidth="1dp"/>



                        <com.google.android.material.chip.Chip

                            android:id="@+id/chipOnline"

                            android:layout_width="wrap_content"

                            android:layout_height="wrap_content"

                            android:text="Online Payment"

                            android:checkable="true"
                            android:textColor="@color/chip_text_selector"

                            app:chipBackgroundColor="@color/chip_payment_selector"

                            app:chipIconTint="@color/chip_text_selector"

                            app:chipIcon="@drawable/ic_cash"

                            app:chipIconVisible="true"

                            app:chipCornerRadius="14dp"

                            app:chipStrokeColor="#D6DCE5"

                            app:chipStrokeWidth="1dp"/>

                    </com.google.android.material.chip.ChipGroup>

                </LinearLayout>

                <!-- Charges & Coupon -->

                <LinearLayout

                    android:layout_width="match_parent"

                    android:layout_height="wrap_content"

                    android:layout_marginTop="14dp"

                    android:orientation="vertical">



                    <!-- Coupon -->

                    <LinearLayout
                        android:visibility="gone"
                        android:id="@+id/layoutCoupon"

                        android:layout_width="match_parent"

                        android:layout_height="wrap_content"

                        android:layout_marginTop="12dp"

                        android:orientation="horizontal"

                        android:gravity="bottom">



                        <com.google.android.material.textfield.TextInputLayout

                            android:layout_width="0dp"

                            android:layout_height="wrap_content"

                            android:layout_weight="1"

                            android:hint="Enter Coupon Code"



                            app:boxBackgroundMode="outline"

                            app:boxCornerRadiusTopStart="14dp"

                            app:boxCornerRadiusTopEnd="14dp"

                            app:boxCornerRadiusBottomStart="14dp"

                            app:boxCornerRadiusBottomEnd="14dp"

                            app:endIconDrawable="@drawable/ic_coupon"

                            app:endIconMode="custom">



                            <com.google.android.material.textfield.TextInputEditText

                                android:id="@+id/etCoupon"

                                android:layout_width="match_parent"

                                android:layout_height="wrap_content"

                                android:inputType="text"

                                android:textSize="10sp"

                                android:maxLines="1"/>



                        </com.google.android.material.textfield.TextInputLayout>



                        <com.google.android.material.button.MaterialButton

                            android:id="@+id/btnApplyCoupon"

                            android:layout_marginStart="10dp"

                            android:text="Apply"

                            android:layout_width="76dp"

                            android:layout_height="48dp"



                            android:textSize="13sp"



                            app:cornerRadius="12dp"



                            android:textAllCaps="false"

                            android:textColor="@android:color/white"

                            android:backgroundTint="@color/sagar_button"/>



                    </LinearLayout>



                    <!-- Bill -->

                    <LinearLayout

                        android:layout_width="match_parent"

                        android:layout_height="wrap_content"

                        android:layout_marginTop="12dp"

                        android:orientation="vertical">



                        <LinearLayout

                            android:layout_width="match_parent"

                            android:layout_height="wrap_content">



                            <TextView

                                android:layout_width="0dp"

                                android:layout_height="wrap_content"

                                android:layout_weight="1"

                                android:textSize="13sp"

                                android:text="Delivery Charge"/>



                            <TextView

                                android:id="@+id/tvDeliveryCharge"

                                android:layout_width="wrap_content"

                                android:layout_height="wrap_content"

                                android:textSize="13sp"

                                android:text="₹40"/>

                        </LinearLayout>



                        <LinearLayout

                            android:layout_width="match_parent"

                            android:layout_height="wrap_content"

                            android:layout_marginTop="8dp">



                            <TextView

                                android:layout_width="0dp"

                                android:layout_height="wrap_content"

                                android:layout_weight="1"

                                android:textSize="13sp"

                                android:text="Coupon Discount"/>



                            <TextView

                                android:id="@+id/tvCouponDiscount"

                                android:layout_width="wrap_content"

                                android:layout_height="wrap_content"

                                android:text="- ₹0"

                                android:textSize="13sp"

                                android:textColor="#2E7D32"/>

                        </LinearLayout>



                        <View

                            android:layout_width="match_parent"

                            android:layout_height="1dp"

                            android:layout_marginVertical="10dp"

                            android:background="#EEEEEE"/>



                        <LinearLayout

                            android:layout_width="match_parent"

                            android:layout_height="wrap_content">



                            <TextView

                                android:layout_width="0dp"

                                android:layout_height="wrap_content"

                                android:layout_weight="1"

                                android:text="Grand Total"

                                android:textSize="16sp"

                                android:textStyle="bold"/>



                            <TextView

                                android:id="@+id/tvGrandTotal"

                                android:layout_width="wrap_content"

                                android:layout_height="wrap_content"

                                android:text="₹260"

                                android:textSize="16sp"

                                android:textStyle="bold"/>

                        </LinearLayout>



                    </LinearLayout>



                </LinearLayout>

                <!-- Buy Now -->

                <com.google.android.material.button.MaterialButton

                    android:id="@+id/btnBuyNow"

                    android:layout_width="match_parent"

                    android:layout_marginTop="24dp"

                    android:text="@string/order_in_1_tap"

                    android:textColor="@color/white"

                    android:layout_height="50dp"



                    android:textSize="14sp"



                    app:cornerRadius="14dp"

                    android:backgroundTint="@color/sagar_button"/>



            </LinearLayout>



        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- SHIMMER OVERLAY -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shimmer_auto_start="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:orientation="vertical">

            <View
                android:layout_width="120dp"
                android:layout_height="18dp"
                android:background="#E6E6E6"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:layout_marginTop="20dp"
                android:background="#E6E6E6"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="16dp"
                android:background="#E6E6E6"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginTop="16dp"
                android:background="#E6E6E6"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:background="#E6E6E6"/>

        </LinearLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>
    <!-- ERROR LAYOUT -->
    <LinearLayout
        android:id="@+id/layoutError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="32dp">

        <ImageView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:src="@drawable/ic_error"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Something went wrong"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Unable to load checkout details"
            android:textColor="#777"
            android:textSize="13sp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRetry"
            android:layout_width="140dp"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:text="Retry"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/sagar_button"
            app:cornerRadius="12dp"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnErrorClose"
            android:layout_width="140dp"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:text="Close"
            android:textColor="@android:color/white"
            android:backgroundTint="@color/slot_active_red"
            app:cornerRadius="12dp"/>
    </LinearLayout>
</FrameLayout>