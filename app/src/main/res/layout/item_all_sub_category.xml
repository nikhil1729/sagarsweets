<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="110dp"
    android:layout_height="140dp"
    android:layout_marginEnd="14dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#FFF7F0"
    app:strokeWidth="1dp"
    app:strokeColor="#F3E3D6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Floating Image -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_subcategory_circle"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/imgSubCategory"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"/>

        </FrameLayout>

        <!-- Category -->
        <TextView
            android:id="@+id/tvSubCategoryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Meal Bowls"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#161616"
            android:maxLines="1"
            android:singleLine="true"
            android:ellipsize="end"/>
        <!-- Decorative line -->
        <View
            android:layout_width="22dp"
            android:layout_height="3dp"
            android:layout_marginTop="8dp"
            android:background="#FF8A00"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>