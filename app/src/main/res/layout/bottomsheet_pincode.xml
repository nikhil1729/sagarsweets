<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:text="Enter Your Pincode"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#000"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="We need your pincode to check delivery availability"
        android:textSize="14sp"
        android:textColor="#666"
        android:layout_marginTop="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/etPincode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter 6-digit pincode"
        android:inputType="number"
        android:maxLength="6"
        android:layout_marginTop="16dp"/>
    <TextView
        android:id="@+id/tvPincodeError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Please enter a valid 6-digit pincode"
        android:textSize="12sp"
        android:textColor="#D32F2F"
        android:visibility="gone"
        android:layout_marginTop="4dp"/>
    <Button
        android:id="@+id/btnConfirmPincode"
        android:text="Confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/sagar_button"
        android:layout_marginTop="20dp"/>

</LinearLayout>
