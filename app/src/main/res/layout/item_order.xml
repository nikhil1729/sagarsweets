<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    android:layout_margin="8dp">

    <LinearLayout
        android:orientation="horizontal"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 🖼 Product Image -->
        <ImageView
            android:id="@+id/imgProduct"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_filter"
            android:layout_marginEnd="10dp"/>

        <!-- Right Content -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">

            <!-- Top Row -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/txtTxnId"
                    android:text="Order #12345"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:textColor="#000"
                    android:layout_weight="1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"/>

                <!-- Delivery Type -->
                <TextView
                    android:id="@+id/txtDeliveryType"
                    android:text="HOME"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#fff"
                    android:padding="4dp"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_delivery_type_pickup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:id="@+id/txtStatus"
                    android:text="Delivered"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:padding="5dp"
                    android:textColor="#fff"
                    android:background="@drawable/bg_status_delivered"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>


            <!-- Date -->
            <TextView
                android:id="@+id/txtDate"
                android:text="12 Mar 2026"
                android:textSize="12sp"
                android:textColor="#777"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- Delivery -->
            <TextView
                android:id="@+id/txtDeliveryDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Delivered on 14 Mar"
                android:textColor="@color/black"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/txtDeliverySlot"
                android:text="Delivered on 14 Mar"
                android:textSize="12sp"
                android:textColor="@color/black"
                android:layout_marginTop="2dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <!-- 📍 Address -->
            <TextView
                android:id="@+id/txtAddress"
                android:text="DLW, Varanasi"
                android:textSize="12sp"
                android:textColor="#555"
                android:layout_marginTop="3dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- Items -->
            <TextView
                android:id="@+id/txtItemCount"
                android:text="3 Items"
                android:textSize="12sp"
                android:textColor="#555"
                android:layout_marginTop="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <!-- Amount -->
            <TextView
                android:id="@+id/txtAmount"
                android:text="₹450"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#000"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:id="@+id/txtCoupon"
                android:text="Coupon: SAGAR20 Applied"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:background="@drawable/bg_coupon_box"
                android:padding="4dp"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <!-- Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <!-- Details Button -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnViewDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Details"
                        android:backgroundTint="@color/sagar_button" />

                    <ProgressBar
                        android:id="@+id/progressDetails"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />

                </FrameLayout>

                <!-- Cancel Button -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancle"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:text="Cancel"
                        android:textAllCaps="false"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:backgroundTint="@color/slot_active_red" />

                    <ProgressBar
                        android:id="@+id/progressCancel"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />

                </FrameLayout>

                <!-- Track Button -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTrack"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:minHeight="48dp"
                        android:text="Track"
                        android:textAllCaps="false"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:backgroundTint="@color/wallet_highlighted_text_holo_dark"
                        android:visibility="visible" />

                    <ProgressBar
                        android:id="@+id/progressTrack"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:visibility="gone" />

                </FrameLayout>

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>