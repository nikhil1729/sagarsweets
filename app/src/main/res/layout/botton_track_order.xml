<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F8FAFC">

    <!-- Header -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Track Order"
        android:textStyle="bold"
        android:textSize="22sp"
        android:textColor="#111827" />


    <!-- Cancelled -->

    <LinearLayout
        android:id="@+id/layoutCancelled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_tracking_card"
        android:padding="20dp"
        android:layout_marginTop="16dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_cancel"
            app:tint="#DC2626" />

        <TextView
            android:id="@+id/txtCancelled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Order Cancelled"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#DC2626"
            android:layout_marginTop="12dp"/>

    </LinearLayout>


    <!-- Waiting -->

    <LinearLayout
        android:id="@+id/layoutWaiting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_tracking_card"
        android:padding="26dp"
        android:layout_marginTop="16dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_receipt_long"
            app:tint="#F59E0B" />

        <TextView
            android:id="@+id/txtWaiting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Waiting for confirmation"
            android:textStyle="bold"
            android:textSize="17sp"
            android:textColor="#111827"
            android:layout_marginTop="14dp"/>

    </LinearLayout>


    <!-- Tracking -->

    <LinearLayout
        android:id="@+id/layoutTracking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_tracking_card"
        android:padding="20dp"
        android:layout_marginTop="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current Status"
            android:textColor="#64748B"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/txtCurrentStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Assigned"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#0F172A"
            android:layout_marginTop="6dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTimeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"/>

    </LinearLayout>

</LinearLayout>